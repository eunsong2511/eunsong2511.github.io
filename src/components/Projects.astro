---
import Icon from './Icon.astro';
import { projects } from '../data/content';
import { sectionNumber, withBase } from '../utils';

// 펼쳐보기 안의 제목들
const detailSections = [
	{ key: 'problem', label: '개발 동기' },
	{ key: 'development', label: '개발 내용' },
	{ key: 'result', label: '결과' },
] as const;
---

<section id="projects" class="section">
	<div class="container">
		<p class="eyebrow">{sectionNumber('projects')} — Projects</p>
		<h2 class="section-title">프로젝트</h2>

		<div class="list">
			{
				projects.map((project) => (
					<article class="project">
						<p class="meta">
							<span class="mono">{project.period}</span>
							<span class="type">{project.type}</span>
						</p>
						<h3>{project.title}</h3>
						<p class="summary">{project.summary}</p>

						<ul class="roles">
							{project.roles.map((role) => (
								<li>{role}</li>
							))}
						</ul>

						{project.highlight && (
							<p class="highlight">
								<span>핵심</span>
								{project.highlight}
							</p>
						)}

						<ul class="chips">
							{project.stack.map((item) => (
								<li class="chip">{item}</li>
							))}
						</ul>

						{project.links.some((link) => link.url) && (
							<div class="links">
								{project.links
									.filter((link) => link.url)
									.map((link) => (
										<a href={link.url} target="_blank" rel="noopener noreferrer">
											{link.label}
											<Icon name="arrow" />
										</a>
									))}
							</div>
						)}

						{project.images.length > 0 && (
							<div class="gallery-wrap">
								<ul class="gallery">
									{project.images.map((image) => (
										<li>
											<a href={withBase(image.src)} target="_blank" rel="noopener noreferrer">
												<img src={withBase(image.src)} alt={image.alt} loading="lazy" />
											</a>
										</li>
									))}
								</ul>
								{project.images.length > 1 && (
									<>
										<button class="gallery-arrow prev" type="button" aria-label="이전 사진" disabled>
											<Icon name="chevron" />
										</button>
										<button class="gallery-arrow next" type="button" aria-label="다음 사진">
											<Icon name="chevron" />
										</button>
									</>
								)}
							</div>
						)}

						{project.details && (
							<details>
								<summary>
									자세히 보기
									<Icon name="chevron" />
								</summary>
								<div class="details-body">
									{detailSections.map(({ key, label }) => {
										const value = project.details[key];
										if (!value || value.length === 0) return null;
										return (
											<div class="detail">
												<h4>{label}</h4>
												{Array.isArray(value) ? (
													<ul>
														{value.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												) : (
													<p>{value}</p>
												)}
											</div>
										);
									})}
								</div>
							</details>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll('.gallery-wrap').forEach((wrap) => {
		const gallery = wrap.querySelector('.gallery');
		const prev = wrap.querySelector<HTMLButtonElement>('.prev');
		const next = wrap.querySelector<HTMLButtonElement>('.next');
		if (!gallery || !prev || !next) return;

		const update = () => {
			prev.disabled = gallery.scrollLeft <= 1;
			next.disabled = gallery.scrollLeft + gallery.clientWidth >= gallery.scrollWidth - 1;
		};
		const move = (direction: number) => {
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			gallery.scrollBy({ left: direction * gallery.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
		};

		prev.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));
		gallery.addEventListener('scroll', update, { passive: true });
		wrap.querySelectorAll('img').forEach((img) => img.addEventListener('load', update));
		update();
	});
</script>

<style>
	.list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 16px;
	}

	.project {
		padding: 28px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 10px;
		font-size: 0.8125rem;
		color: var(--subtle);
	}

	.type::before {
		content: '·';
		margin-right: 10px;
	}

	h3 {
		margin-top: 8px;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.4;
	}

	.summary {
		margin-top: 6px;
		color: var(--muted);
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}

	.roles li {
		padding: 2px 9px;
		border-radius: 6px;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.highlight {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-top: 18px;
		padding: 12px 16px;
		border-radius: 10px;
		background: var(--surface);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.highlight span {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-text);
	}

	.chips {
		margin-top: 16px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 18px;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.links a:hover {
		color: var(--accent-text);
	}

	.links :global(svg) {
		width: 14px;
		height: 14px;
	}

	.gallery-wrap {
		position: relative;
		margin-top: 20px;
	}

	.gallery {
		display: flex;
		gap: 12px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.gallery::-webkit-scrollbar {
		display: none;
	}

	.gallery li {
		flex: none;
		scroll-snap-align: start;
	}

	.gallery img {
		display: block;
		width: auto;
		height: 420px;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface);
	}

	.gallery-arrow {
		position: absolute;
		top: 50%;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--bg);
		color: var(--text);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
		cursor: pointer;
		transform: translateY(-50%);
	}

	.gallery-arrow:disabled {
		display: none;
	}

	.gallery-arrow :global(svg) {
		width: 20px;
		height: 20px;
	}

	.gallery-arrow.prev {
		left: 10px;
	}

	.gallery-arrow.prev :global(svg) {
		transform: rotate(90deg);
	}

	.gallery-arrow.next {
		right: 10px;
	}

	.gallery-arrow.next :global(svg) {
		transform: rotate(-90deg);
	}

	/* 사진이 한 장이면 PC에서는 카드 너비에 꽉 차게 보여요 */
	@media (min-width: 641px) {
		.gallery li:only-child {
			flex: 1;
		}

		.gallery li:only-child img {
			width: 100%;
			height: auto;
		}
	}

	details {
		margin-top: 22px;
		border-top: 1px solid var(--border);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 6px;
		width: fit-content;
		padding-top: 16px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--text);
	}

	summary :global(svg) {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	details[open] summary :global(svg) {
		transform: rotate(180deg);
	}

	.details-body {
		display: grid;
		gap: 20px;
		padding-top: 20px;
	}

	h4 {
		margin-bottom: 6px;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--accent-text);
	}

	.detail p,
	.detail li {
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.detail li {
		position: relative;
		padding-left: 16px;
	}

	.detail li + li {
		margin-top: 4px;
	}

	.detail li::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.72em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--subtle);
	}

	@media (max-width: 640px) {
		.project {
			padding: 22px 18px;
		}

		h3 {
			font-size: 1.15rem;
		}

		/* 휴대폰에서는 사진이 화면보다 넓어서 손가락으로 자유롭게 밀어 봐요 */
		.gallery {
			scroll-snap-type: none;
		}

		.gallery img {
			height: 260px;
		}

		.gallery-arrow {
			display: none;
		}
	}
</style>
