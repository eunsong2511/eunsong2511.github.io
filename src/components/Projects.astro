---
import Icon from './Icon.astro';
import { projects } from '../data/content';
import { sectionNumber } from '../utils';

// 펼쳐보기 안의 제목들
const detailSections = [
	{ key: 'problem', label: '왜 만들었나' },
	{ key: 'planning', label: '기획에서 한 일' },
	{ key: 'development', label: '개발에서 한 일' },
	{ key: 'result', label: '결과' },
] as const;
---

<section id="projects" class="section">
	<div class="container">
		<p class="eyebrow">{sectionNumber('projects')} — Projects</p>
		<h2 class="section-title">프로젝트</h2>

		<div class="list">
			{
				projects.map((project) => (
					<article class="project">
						<p class="meta">
							<span class="mono">{project.period}</span>
							<span class="type">{project.type}</span>
						</p>
						<h3>{project.title}</h3>
						<p class="summary">{project.summary}</p>

						<ul class="roles">
							{project.roles.map((role) => (
								<li>{role}</li>
							))}
						</ul>

						{project.highlight && (
							<p class="highlight">
								<span>핵심</span>
								{project.highlight}
							</p>
						)}

						<ul class="chips">
							{project.stack.map((item) => (
								<li class="chip">{item}</li>
							))}
						</ul>

						{project.links.some((link) => link.url) && (
							<div class="links">
								{project.links
									.filter((link) => link.url)
									.map((link) => (
										<a href={link.url} target="_blank" rel="noopener noreferrer">
											{link.label}
											<Icon name="arrow" />
										</a>
									))}
							</div>
						)}

						{project.details && (
							<details>
								<summary>
									자세히 보기
									<Icon name="chevron" />
								</summary>
								<div class="details-body">
									{detailSections.map(({ key, label }) => {
										const value = project.details[key];
										if (!value || value.length === 0) return null;
										return (
											<div class="detail">
												<h4>{label}</h4>
												{Array.isArray(value) ? (
													<ul>
														{value.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												) : (
													<p>{value}</p>
												)}
											</div>
										);
									})}
								</div>
							</details>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.list {
		display: grid;
		gap: 16px;
	}

	.project {
		padding: 28px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 10px;
		font-size: 0.8125rem;
		color: var(--subtle);
	}

	.type::before {
		content: '·';
		margin-right: 10px;
	}

	h3 {
		margin-top: 8px;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.4;
	}

	.summary {
		margin-top: 6px;
		color: var(--muted);
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}

	.roles li {
		padding: 2px 9px;
		border-radius: 6px;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.highlight {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-top: 18px;
		padding: 12px 16px;
		border-radius: 10px;
		background: var(--surface);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.highlight span {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-text);
	}

	.chips {
		margin-top: 16px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 18px;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.links a:hover {
		color: var(--accent-text);
	}

	.links :global(svg) {
		width: 14px;
		height: 14px;
	}

	details {
		margin-top: 22px;
		border-top: 1px solid var(--border);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 6px;
		width: fit-content;
		padding-top: 16px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--text);
	}

	summary :global(svg) {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	details[open] summary :global(svg) {
		transform: rotate(180deg);
	}

	.details-body {
		display: grid;
		gap: 20px;
		padding-top: 20px;
	}

	h4 {
		margin-bottom: 6px;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--accent-text);
	}

	.detail p,
	.detail li {
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.detail li {
		position: relative;
		padding-left: 16px;
	}

	.detail li + li {
		margin-top: 4px;
	}

	.detail li::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.72em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--subtle);
	}

	@media (max-width: 640px) {
		.project {
			padding: 22px 18px;
		}

		h3 {
			font-size: 1.15rem;
		}
	}
</style>
